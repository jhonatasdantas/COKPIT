{
  "name": "cockpit",
  "version": "0.0.0",
  "private": true,
  "description": "Cockpit Ide — SaaS multi-tenant para consultores de e-commerce (Cloudflare-native)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @cockpit/api",
    "dev:web": "npm run dev --workspace @cockpit/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "deploy:api": "npm run deploy --workspace @cockpit/api"
  },
  "engines": {
    "node": ">=20"
  }
}
